generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projects     Project[]
  workflows    Workflow[]
  courses      Course[]
  socialPosts  SocialPost[]
  socialSessions SocialSession[]
  socialInbox SocialInbox[]
  youtubeVideos YouTubeVideo[]
}

model Project {
  id              String   @id @default(cuid())
  name            String
  description     String?
  niche           String?
  pages           String?
  brandColors     String?
  status          String   @default("DRAFT")
  source          String   @default("GENERATED")
  hasLogin        Boolean  @default(false)
  generateSystem  Boolean  @default(false)
  prompt          String?
  blueprint       String?
  repositoryUrl   String?
  deploymentUrl   String?
  domain          String?
  health          String   @default("UNKNOWN")
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  managementLogs  ManagementLog[]
  deployments     DeploymentSnapshot[]
  domains         DomainBinding[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ManagementLog {
  id        String   @id @default(cuid())
  type      String
  title     String
  details   String?
  amount    Int?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DeploymentSnapshot {
  id         String   @id @default(cuid())
  projectId  String
  status     String
  url        String?
  checkedAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DomainBinding {
  id         String   @id @default(cuid())
  projectId  String
  domain     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  source    String?
  metadata  String?
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  provider  String
  label     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderConnection {
  id        String   @id @default(cuid())
  provider  String   @unique
  connector String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id                    String   @id @default(cuid())
  name                  String
  template              String?
  graph                 String
  status                String   @default("DRAFT")
  activepiecesId        String?
  activepiecesStatus    String?
  ownerId               String
  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  runs                  WorkflowRun[]
  alerts                WorkflowAlert[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WorkflowRun {
  id          String   @id @default(cuid())
  workflowId  String
  status      String
  externalId  String?
  logs        String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowAlert {
  id          String   @id @default(cuid())
  workflowId  String
  severity    String   @default("ERROR")
  message     String
  acknowledged Boolean  @default(false)
  createdAt   DateTime @default(now())
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model Course {
  id          String         @id @default(cuid())
  title       String
  topic       String
  description String?
  status      String         @default("DRAFT")
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  modules     CourseModule[]
  enrollments Enrollment[]
  payments    PaymentLink[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model CourseModule {
  id        String   @id @default(cuid())
  title     String
  position  Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id          String       @id @default(cuid())
  title       String
  position    Int
  youtubeUrl  String?
  script      String?
  status      String       @default("DRAFT")
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videos      Video[]
  progresses  Progress[]
  quiz        Quiz?
  assignment  Assignment?
}

model Quiz {
  id       String @id @default(cuid())
  prompt   String
  answer   String
  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Assignment {
  id       String @id @default(cuid())
  prompt   String
  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Video {
  id        String   @id @default(cuid())
  provider  String
  status    String   @default("PENDING")
  externalId String?
  url       String?
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Enrollment {
  id        String     @id @default(cuid())
  email     String
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses Progress[]
  createdAt DateTime   @default(now())
  @@unique([email, courseId])
}

model Progress {
  id           String     @id @default(cuid())
  completed    Boolean    @default(false)
  enrollmentId String
  lessonId     String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([enrollmentId, lessonId])
}

model PaymentLink {
  id         String   @id @default(cuid())
  provider   String
  currency   String
  amount     Int
  status     String   @default("PENDING")
  url        String?
  externalId String?
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model SocialSession {
  id String @id @default(cuid())
  platform String
  status String @default("ACTIVE")
  storageState String
  accountId String?
  accountName String?
  lastCheckedAt DateTime @default(now())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@unique([ownerId, platform])
}

model SocialPost {
  id String @id @default(cuid())
  platform String
  caption String
  hashtags String?
  scheduledAt DateTime?
  publishedAt DateTime?
  status String @default("DRAFT")
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialInbox {
  id String @id @default(cuid())
  platform String
  sender String
  message String
  reply String?
  status String @default("OPEN")
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model YouTubeVideo {
  id            String   @id @default(cuid())
  title         String
  topic         String
  stage         String   @default("RESEARCH")
  status        String   @default("DRAFT")
  research      String?
  script        String?
  scheduledAt   DateTime?
  youtubeId     String?
  youtubeUrl    String?
  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assets        YouTubeAsset[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model YouTubeAsset {
  id        String   @id @default(cuid())
  type      String
  status    String   @default("QUEUED")
  provider  String?
  url       String?
  externalId String?
  videoId   String
  video     YouTubeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
